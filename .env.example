# Se completan cuando se vincula un proyecto de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Nunca expongas una secret key o service role con NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# URL publica canonica usada en enlaces de autenticacion.
# En desarrollo: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# demo: presenta los datos ficticios sin escribirlos en Supabase.
# live: presenta exclusivamente la informacion real del usuario.
# Si se omite, usa demo en development y live en production.
ANISUBA_DATA_MODE=

# Mi biblioteca es el primer modulo conectado de extremo a extremo.
# live (predeterminado): solo datos reales del usuario autenticado.
# demo: datos ficticios, exclusivamente para validacion visual.
ANISUBA_LIBRARY_DATA_MODE=live
ANISUBA_DASHBOARD_DATA_MODE=live

# Descubrimiento de AniList y alertas derivadas de la biblioteca.
# live (predeterminado): consulta señales reales y conserva el modo demo del resto de módulos.
# demo: usa los catálogos y notificaciones ficticios aprobados.
ANISUBA_EXPLORE_DATA_MODE=live
ANISUBA_NOTIFICATIONS_DATA_MODE=live

# Estos módulos conservan temporalmente las maquetas aprobadas hasta que su
# lectura real quede implementada de extremo a extremo.
ANISUBA_HISTORY_DATA_MODE=demo
ANISUBA_STATISTICS_DATA_MODE=demo
ANISUBA_PROFILE_DATA_MODE=demo

# Protege la tarea programada diaria de notificaciones en Vercel.
CRON_SECRET=

# Correo opcional. Sin estas variables las alertas siguen funcionando dentro de AniSuba.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
